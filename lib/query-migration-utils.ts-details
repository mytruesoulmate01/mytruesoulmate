/**
 * Utilities to help migrate from PostgreSQL parameter style to Neon template literals
 */

export interface QueryMigrationResult {
  success: boolean
  originalQuery: string
  migratedQuery: string
  parameters: any[]
  warnings: string[]
}

/**
 * Convert PostgreSQL parameter style ($1, $2) to template literal placeholders
 * This is a helper for understanding the migration pattern
 */
export function analyzeQueryMigration(originalQuery: string, parameters: any[]): QueryMigrationResult {
  const warnings: string[] = []
  let migratedQuery = originalQuery

  // Find all parameter placeholders
  const parameterMatches = originalQuery.match(/\$\d+/g) || []
  const uniqueParams = [...new Set(parameterMatches)]

  if (uniqueParams.length !== parameters.length) {
    warnings.push(
      `Parameter count mismatch: found ${uniqueParams.length} placeholders but ${parameters.length} parameters provided`,
    )
  }

  // Convert $1, $2, etc. to ${param1}, ${param2}, etc.
  uniqueParams.forEach((placeholder, index) => {
    const paramNumber = Number.parseInt(placeholder.substring(1))
    migratedQuery = migratedQuery.replace(new RegExp(`\\${placeholder}`, "g"), `\${param${paramNumber}}`)
  })

  // Add template literal backticks
  migratedQuery = `\`${migratedQuery}\``

  return {
    success: warnings.length === 0,
    originalQuery,
    migratedQuery,
    parameters,
    warnings,
  }
}

/**
 * Common query patterns and their migrations
 */
export const QUERY_MIGRATION_EXAMPLES = {
  simpleSelect: {
    before: {
      query: "SELECT * FROM user_registration WHERE email_id = $1",
      params: ["user@example.com"],
    },
    after: {
      template: "SELECT * FROM user_registration WHERE email_id = ${email}",
      usage: "await sql`SELECT * FROM user_registration WHERE email_id = ${email}`",
    },
  },

  multipleParams: {
    before: {
      query: "UPDATE user_registration SET user_role = $1, token_version = $2 WHERE user_id = $3",
      params: ["admin", 2, 123],
    },
    after: {
      template:
        "UPDATE user_registration SET user_role = ${userRole}, token_version = ${tokenVersion} WHERE user_id = ${userId}",
      usage:
        "await sql`UPDATE user_registration SET user_role = ${userRole}, token_version = ${tokenVersion} WHERE user_id = ${userId}`",
    },
  },

  insertReturning: {
    before: {
      query: "INSERT INTO user_registration (email_id, password) VALUES ($1, $2) RETURNING user_id",
      params: ["user@example.com", "hashedPassword"],
    },
    after: {
      template: "INSERT INTO user_registration (email_id, password) VALUES (${email}, ${password}) RETURNING user_id",
      usage:
        "await sql`INSERT INTO user_registration (email_id, password) VALUES (${email}, ${password}) RETURNING user_id`",
    },
  },

  arrayParameter: {
    before: {
      query: "SELECT user_id, email_id FROM user_registration WHERE user_id = ANY($1)",
      params: [[1, 2, 3, 4, 5]],
    },
    after: {
      template: "SELECT user_id, email_id FROM user_registration WHERE user_id IN (${userIds.join(',')})",
      usage: "await sql`SELECT user_id, email_id FROM user_registration WHERE user_id IN (${sql(userIds)})`",
      note: "Array parameters need special handling in Neon",
    },
  },
}

/**
 * Validate migrated query syntax
 */
export function validateMigratedQuery(query: string): {
  isValid: boolean
  errors: string[]
  suggestions: string[]
} {
  const errors: string[] = []
  const suggestions: string[] = []

  // Check for template literal format
  if (!query.startsWith("`") || !query.endsWith("`")) {
    errors.push("Query should be wrapped in template literal backticks")
  }

  // Check for old parameter style
  if (query.includes("$1") || query.includes("$2")) {
    errors.push("Query still contains PostgreSQL parameter placeholders ($1, $2, etc.)")
    suggestions.push("Replace $1, $2, etc. with ${variableName} template literal syntax")
  }

  // Check for proper variable interpolation
  const interpolationMatches = query.match(/\$\{[^}]+\}/g) || []
  if (interpolationMatches.length === 0 && query.includes("WHERE")) {
    suggestions.push("Consider if this query needs parameter interpolation")
  }

  return {
    isValid: errors.length === 0,
    errors,
    suggestions,
  }
}
