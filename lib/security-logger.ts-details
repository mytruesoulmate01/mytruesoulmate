// Specialized security logging for password reset operations
import { advancedLogger } from "./advanced-logger"

interface SecurityEvent {
  eventType: "suspicious_activity" | "rate_limit_exceeded" | "invalid_token_attempt" | "brute_force_attempt"
  severity: "low" | "medium" | "high" | "critical"
  userId?: string
  email?: string
  ipAddress: string
  userAgent?: string
  details: Record<string, any>
  timestamp: Date
}

class SecurityLogger {
  private static instance: SecurityLogger
  private securityEvents: SecurityEvent[] = []

  private constructor() {}

  static getInstance(): SecurityLogger {
    if (!SecurityLogger.instance) {
      SecurityLogger.instance = new SecurityLogger()
    }
    return SecurityLogger.instance
  }

  logSuspiciousActivity(event: Omit<SecurityEvent, "timestamp">) {
    const securityEvent: SecurityEvent = {
      ...event,
      timestamp: new Date(),
    }

    this.securityEvents.push(securityEvent)

    // Log to advanced logger
    advancedLogger.logSecurityEvent({
      step: "security_monitoring",
      eventType: event.eventType,
      severity: event.severity,
      userId: event.userId,
      email: event.email,
      ipAddress: event.ipAddress,
      metadata: event.details,
    })

    // For critical events, also log to error level
    if (event.severity === "critical") {
      advancedLogger.error("Critical security event detected", undefined, {
        step: "security_critical",
        userId: event.userId,
        email: event.email,
        ipAddress: event.ipAddress,
        metadata: event.details,
      })
    }
  }

  logPasswordResetAttempt(data: {
    userId?: string
    email: string
    ipAddress: string
    success: boolean
    failureReason?: string
    userAgent?: string
  }) {
    if (data.success) {
      advancedLogger.logPasswordResetSuccess({
        step: "password_reset",
        substep: "completion",
        userId: data.userId,
        email: data.email,
        ipAddress: data.ipAddress,
      })
    } else {
      this.logSuspiciousActivity({
        eventType: "invalid_token_attempt",
        severity: "medium",
        userId: data.userId,
        email: data.email,
        ipAddress: data.ipAddress,
        userAgent: data.userAgent,
        details: {
          failureReason: data.failureReason,
          timestamp: new Date().toISOString(),
        },
      })
    }
  }

  logRateLimitExceeded(data: {
    type: "global" | "user"
    userId?: string
    email?: string
    ipAddress: string
    attemptCount: number
    timeWindow: string
  }) {
    this.logSuspiciousActivity({
      eventType: "rate_limit_exceeded",
      severity: data.type === "global" ? "high" : "medium",
      userId: data.userId,
      email: data.email,
      ipAddress: data.ipAddress,
      details: {
        limitType: data.type,
        attemptCount: data.attemptCount,
        timeWindow: data.timeWindow,
      },
    })
  }

  getSecurityEventsSummary(timeRange: { start: Date; end: Date }) {
    const eventsInRange = this.securityEvents.filter(
      (event) => event.timestamp >= timeRange.start && event.timestamp <= timeRange.end,
    )

    return {
      total: eventsInRange.length,
      bySeverity: {
        low: eventsInRange.filter((e) => e.severity === "low").length,
        medium: eventsInRange.filter((e) => e.severity === "medium").length,
        high: eventsInRange.filter((e) => e.severity === "high").length,
        critical: eventsInRange.filter((e) => e.severity === "critical").length,
      },
      byType: eventsInRange.reduce(
        (acc, event) => {
          acc[event.eventType] = (acc[event.eventType] || 0) + 1
          return acc
        },
        {} as Record<string, number>,
      ),
      topIPs: this.getTopIPs(eventsInRange),
    }
  }

  private getTopIPs(events: SecurityEvent[]): Array<{ ip: string; count: number }> {
    const ipCounts = events.reduce(
      (acc, event) => {
        acc[event.ipAddress] = (acc[event.ipAddress] || 0) + 1
        return acc
      },
      {} as Record<string, number>,
    )

    return Object.entries(ipCounts)
      .map(([ip, count]) => ({ ip, count }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 10)
  }
}

export const securityLogger = SecurityLogger.getInstance()
